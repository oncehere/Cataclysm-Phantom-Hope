{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oncehere/Cataclysm-Phantom-Hope/blob/main/ai/repository-settings.target.schema.json",
  "title": "CPH repository settings observation and deferred gates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "description", "enforcement", "audit", "entries", "post_merge_intake"],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "repository_settings_target"},
    "description": {"type": "string", "minLength": 1},
    "enforcement": {"const": "deferred"},
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["observed_at", "observed_timestamp", "evidence_scope", "observation_commands", "repository", "actions", "security", "rulesets"],
      "properties": {
        "observed_at": {"type": "string", "format": "date"},
        "observed_timestamp": {"type": "string", "format": "date-time"},
        "evidence_scope": {"type": "string", "minLength": 1},
        "observation_commands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "repository": {
          "type": "object", "additionalProperties": false,
          "required": ["full_name", "default_branch", "main_sha", "fork", "parent", "main_protected", "has_issues", "has_discussions", "allow_auto_merge"],
          "properties": {
            "full_name": {"const": "oncehere/Cataclysm-Phantom-Hope"},
            "default_branch": {"const": "main"},
            "main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "fork": {"const": true},
            "parent": {"const": "CleverRaven/Cataclysm-DDA"},
            "main_protected": {"type": "boolean"},
            "has_issues": {"type": "boolean"},
            "has_discussions": {"type": "boolean"},
            "allow_auto_merge": {"type": "boolean"}
          }
        },
        "actions": {
          "type": "object", "additionalProperties": false,
          "required": ["default_workflow_permissions", "can_approve_pull_request_reviews"],
          "properties": {
            "default_workflow_permissions": {"enum": ["read", "write"]},
            "can_approve_pull_request_reviews": {"type": "boolean"}
          }
        },
        "security": {
          "type": "object", "additionalProperties": false,
          "required": ["secret_scanning", "secret_scanning_push_protection", "dependabot_security_updates", "private_vulnerability_reporting"],
          "properties": {
            "secret_scanning": {"enum": ["enabled", "disabled"]},
            "secret_scanning_push_protection": {"enum": ["enabled", "disabled"]},
            "dependabot_security_updates": {"enum": ["enabled", "disabled"]},
            "private_vulnerability_reporting": {"type": "boolean"}
          }
        },
        "rulesets": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "name", "branch", "enforcement"],
            "properties": {
              "id": {"type": "integer", "minimum": 1},
              "name": {"type": "string", "minLength": 1},
              "branch": {"enum": ["main", "master"]},
              "enforcement": {"enum": ["active", "disabled"]}
            }
          }
        }
      }
    },
    "entries": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/main_gate"}},
    "post_merge_intake": {
      "type": "object", "additionalProperties": false,
      "required": ["target_issues_enabled", "target_private_vulnerability_reporting_enabled", "cleanup_pr_merged", "ready_to_enable"],
      "properties": {
        "target_issues_enabled": {"const": true},
        "target_private_vulnerability_reporting_enabled": {"const": true},
        "cleanup_pr_merged": {"type": "boolean"},
        "ready_to_enable": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "main_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "branch", "observed_ruleset_id", "observed_enforcement", "desired_enforcement", "required_context", "prerequisites", "ready_to_enable", "post_activation_probe_verified", "operational", "enabled_at", "blockers"],
      "properties": {
        "id": {"const": "main-merge-gate"},
        "branch": {"const": "main"},
        "observed_ruleset_id": {"type": "integer", "minimum": 1},
        "observed_enforcement": {"enum": ["active", "disabled"]},
        "desired_enforcement": {"const": "active"},
        "required_context": {"const": "cph/trusted-gate"},
        "prerequisites": {
          "type": "object", "additionalProperties": false,
          "required": ["windows_linux_checks_verified", "trusted_gate_verified"],
          "properties": {
            "windows_linux_checks_verified": {"type": "boolean"},
            "trusted_gate_verified": {"type": "boolean"}
          }
        },
        "ready_to_enable": {"type": "boolean"},
        "post_activation_probe_verified": {"type": "boolean"},
        "operational": {"type": "boolean"},
        "enabled_at": {"type": ["string", "null"], "format": "date-time"},
        "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
