      "generator_platform": "x64",
      "configuration": "RelWithDebInfo",
      "options": {
        "TILES": true,
        "SOUND": true,
        "LOCALIZE": true,
        "CATA_ENABLE_LUA_PLATFORM": true,
        "TESTS": true,
        "BUILD_TESTING": true,
        "CURSES": false,
        "USE_PREFIX_DATA_DIR": false,
        "USE_XDG_DIR": false,
        "USE_SDL3": false,
