{
  "schema_version": 1,
  "policy_version": "e4-native-and-tooling-v2",
  "protected_surfaces": {
    "path": "protected-surfaces.json",
    "sha256": "7857b7ca5c00e9ec8722486c273832b5b416d668dbd85571e242661d646d564d"
  },
  "required_platforms": [
    "windows",
    "linux"
  ],
  "informational_platforms": [
    "macos",
    "android"
  ],
  "required_event": "pull_request",
  "targets": {
    "linux": {
      "target_id": "e1-linux-tiles-sounds-x64",
      "os": "linux",
      "arch": "x86_64",
      "native": true,
      "preset": "linux-tiles-sounds-x64",
      "generator": "Ninja",
      "configuration": "RelWithDebInfo",
      "c_flags": "-O1 -g0 -DNDEBUG",
      "cxx_flags": "-O1 -g0 -DNDEBUG",
      "options": {
        "TILES": true,
        "SOUND": true,
        "LOCALIZE": true,
        "CATA_ENABLE_LUA_PLATFORM": true,
        "TESTS": true,
        "BUILD_TESTING": true,
        "CURSES": false,
        "USE_PREFIX_DATA_DIR": false,
        "USE_XDG_DIR": false,
        "CPH_TEST_IDENTITY": false
      },
      "binaries": [
        "src/cataclysm-tiles",
        "tests/cata_test-tiles"
      ],
      "tests": {
        "translations": "[translations]~[.]",
        "chinese-runtime": "TranslationPluralRulesEvaluatorPerformance",
        "horde-map": "horde_map_*",
        "lua-gc": "lua_platform_same_signature_callbacks_destroy_their_own_captures",
        "lua-callback": "lua_platform_callback_errors_name_the_trigger_and_continue_dispatch",
        "lua-task": "lua_platform_task_failure_message_identifies_the_scheduled_instance",
        "actor-control": "[actor_control]~[.]"
      }
    },
    "windows": {
      "target_id": "e1-windows-tiles-sounds-x64-msvc",
      "os": "windows",
      "arch": "x86_64",
      "native": true,
      "preset": "windows-tiles-sounds-x64-msvc",
      "generator": "Visual Studio 17 2022",
      "generator_platform": "x64",
      "configuration": "RelWithDebInfo",
      "options": {
        "TILES": true,
        "SOUND": true,
        "LOCALIZE": true,
        "CATA_ENABLE_LUA_PLATFORM": true,
        "TESTS": true,
        "BUILD_TESTING": true,
        "CURSES": false,
        "USE_PREFIX_DATA_DIR": false,
        "USE_XDG_DIR": false,
        "USE_HOME_DIR": false,
        "CATA_CCACHE": false,
        "VCPKG_MANIFEST_INSTALL": false
      },
      "vcpkg_commit": "f6672d8e480ccdecddfad3fd1b838ba369ffe6cd",
      "vcpkg_triplet": "x64-windows-static",
      "binaries": [
        "bin/cataclysm-tiles.exe",
        "bin/cata_test-tiles.exe"
      ],
      "tests": {
        "translations": "[translations]~[.]",
        "chinese-runtime": "TranslationPluralRulesEvaluatorPerformance",
        "horde-map": "horde_map_*",
        "lua-gc": "lua_platform_same_signature_callbacks_destroy_their_own_captures"
      }
    }
  },
  "tooling": {
    "python_version": "3.12.10",
    "requirements": "tools/requirements-validation.txt",
    "suites": {
      "agent": {
        "directory": "tools/agent",
        "excluded_prefixes": []
      },
      "project": {
        "directory": "tests/project",
        "excluded_prefixes": []
      },
      "lua": {
        "directory": "tools/lua_api",
        "excluded_prefixes": [
          "test_mod_sdk.LuaLanguageServerIntegrationTest."
        ]
      },
      "json": {
        "directory": "tools/json_api",
        "excluded_prefixes": []
      },
      "actor-protocol": {
        "directory": "tools/actor_control",
        "excluded_prefixes": []
      }
    },
    "checks": {
      "metadata": [
        "tools/agent/check_project_metadata.py"
      ],
      "documentation-registry": [
        "tools/agent/generate_documentation_registry.py",
        "--check"
      ],
      "agent-benchmark": [
        "tools/agent/benchmark_context_pack.py",
        "--check"
      ],
      "lua-inventory": [
        "tools/lua_api/generate_platform_native_inventory.py",
        "--check"
      ],
      "lua-contract": [
        "tools/lua_api/generate_platform_contract.py",
        "--check"
      ],
      "lua-coverage": [
        "tools/lua_api/generate_platform_coverage.py",
        "--check"
      ],
      "json-contracts": [
        "tools/json_api/generate_contracts.py",
        "--check"
      ],
      "workflow-inventory": [
        "tools/project/check_remote_workflows.py"
      ],
      "actor-protocol-generated": [
        "tools/actor_control/generate_protocol.py",
        "--check"
      ]
    }
  }
}
