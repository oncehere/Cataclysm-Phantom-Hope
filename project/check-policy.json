        "USE_PREFIX_DATA_DIR": false,
        "USE_XDG_DIR": false,
        "USE_SDL3": true,
        "CPH_TEST_IDENTITY": false
      },
      "binaries": [
        "src/cataclysm-tiles",
        "tests/cata_test-tiles"
      ],
      "tests": {
        "translations": "[translations]~[.]",
        "chinese-runtime": "TranslationPluralRulesEvaluatorPerformance",
        "horde-map": "horde_map_*",
